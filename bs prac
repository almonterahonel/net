function check_pass() {
  var regExp = /(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[!@#$%&*()]).{20,}/;
  cur = 10000 - total_password_checks
  pass1 = $("#pass1").val()
  pass2 = $("#pass2").val()
  if (regExp.test(pass1) && pass1 == pass2) {
    $("#pass1").val("")
    $("#pass2").val("")
    if (used_passwords.includes(pass1)) {
      alert("you already used that password!");
      return
    }
    used_passwords.push(pass1);
    total_password_checks += 1;
    cur = 10000 - total_password_checks
    if (cur > 0) {
      alert("great! now do it " + cur + " more times!")
      change_score(10);
    } else {
      alert("you did it! press next to print your certificate")
      change_score(50);
    }
  } else {
    alert("your passwords did not match or they did not meet a password complexity requirement.")
    change_score(-15);
  }
  if (cur <= cur) {
