  var phase = 0;
var score = 0;


function restart() {
  phase = 0
  score = 0
  zero_state()
  update_score_display()
  empty_content()
  start()
}

function empty_content() {
  $("#content").children().remove()
}

function update_score_display() {
  $("#score").text(score);
}

function start() {
  itme = {
    disabled: false
  }
  next(itme)
}

function next(item) {
  if (item.disabled != true) {
    if (state[phase] + "" == "true") {
      phase += 1
      if (phase >= phases.length) {
        win_the_game();
      } else {
        phases[phase]()
      }
    } else {
      phases[phase]()
    }
  }
  item.disabled = true
}

function zero_state() {
  for (i = 0; i < phases.length; i++) {
    state[i] = false;
  }
}

function save_state() {
  cookie_string = ""
  for (i = 0; i < state.length; i++) {
    if (i != 0) {
      cookie_string += ","
    }
    cookie_string += state[i]
  }
  document.cookie = encodeURI("state=" + cookie_string + ";")
  document.cookie = encodeURI("score=" + score + ";")
}

function getCookie(cname) {
  // taken from w3schools via: https://www.w3schools.com/js/js_cookies.asp
  var name = cname + "=";
  var decodedCookie = decodeURIComponent(document.cookie);
  var ca = decodedCookie.split(';');
  for (var i = 0; i < ca.length; i++) {
    var c = ca[i];
    while (c.charAt(0) == ' ') {
      c = c.substring(1);
    }
    if (c.indexOf(name) == 0) {
      return c.substring(name.length, c.length);
    }
  }
  return "";
}

function load_state() {
  score = Number(getCookie("score"))
  state = getCookie("state").split(",")
  update_score_display()
  for (i = 0; i < state.length; i++) {
    if (state[i] + "" == "true") {
      phase = i
    } else {
      break;
    }
  }
}

$(document).ready(function() {
  zero_state();
  load_state();
  start()
});

function complete_phase() {
  state[phase] = true
  $("#nextbutton").removeAttr("disabled");
  save_state()
}

function change_score(v) {
  score += v;
  if (v > 0) color = "green"
  else color = "red"
  pop = $("<div style='z-index:999;position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);color:" + color + ";font-size:3em;'>" + v + "</div>");
  $("#content").append(pop);
  if (v < 0) {
    eff = "pulsate"
  } else {
    eff = "bounce"
  }
  pop.effect(eff, "slow", function() {
    pop.hide("puff", "slow", function() {
      pop.remove();
    });
  });
  update_score_display()
}

